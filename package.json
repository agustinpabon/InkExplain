{
  "name": "inkexplain",
  "version": "1.2.0",
  "private": true,
  "description": "Turn code, docs, and ideas into hand-drawn illustrations with AI agents.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "build:docs": "node scripts/build-docs.mjs",
    "explain": "node scripts/explain.mjs",
    "archetype:add": "node scripts/add-archetype.mjs",
    "check": "node scripts/build-docs.mjs --check && node scripts/validate.mjs && node --test \"tests/**/*.test.mjs\""
  }
}
